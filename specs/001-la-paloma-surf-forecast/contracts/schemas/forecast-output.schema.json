{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surf-forecast.local/schemas/forecast-output-1.0.0.json",
  "title": "Surf Forecast Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "overall_status",
    "snapshot_id",
    "query",
    "criteria",
    "sources",
    "days",
    "profiles",
    "incidents",
    "attribution",
    "shared_regional_input"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "overall_status": {
      "enum": ["complete", "degraded"]
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^q_[0-9]{8}T[0-9]{6}Z_[a-f0-9]{8,}$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reference_time", "timezone", "horizon_start", "horizon_end"],
      "properties": {
        "mode": {
          "enum": ["normal", "force_refresh", "stored_only", "fixture_replay"]
        },
        "reference_time": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "America/Montevideo"
        },
        "horizon_start": {
          "type": "string",
          "format": "date"
        },
        "horizon_end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criteria_version",
        "point_k",
        "range_k_low",
        "range_k_high",
        "surfable_threshold_m"
      ],
      "properties": {
        "criteria_version": {"type": "string"},
        "point_k": {"type": "number", "exclusiveMinimum": 0},
        "range_k_low": {"type": "number", "minimum": 0},
        "range_k_high": {"type": "number", "minimum": 0},
        "surfable_threshold_m": {"type": "number", "minimum": 0}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "provider",
          "service",
          "dataset",
          "model",
          "independence_group",
          "status",
          "downloaded_at",
          "data_age_seconds",
          "requested_coordinate",
          "resolved_coordinate",
          "model_run_availability"
        ],
        "properties": {
          "source_id": {"type": "string"},
          "provider": {"type": "string"},
          "service": {"type": "string"},
          "dataset": {"type": "string"},
          "model": {"type": "string"},
          "independence_group": {"type": "string"},
          "status": {
            "enum": ["success", "fresh_cache", "stale_cache", "failed"]
          },
          "downloaded_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "data_age_seconds": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "requested_coordinate": {"$ref": "#/$defs/geoPoint"},
          "resolved_coordinate": {
            "oneOf": [
              {"$ref": "#/$defs/geoPoint"},
              {"type": "null"}
            ]
          },
          "model_run_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "model_run_availability": {
            "enum": ["available", "unavailable", "unknown"]
          }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_date",
          "state",
          "headline",
          "headline_code",
          "best_peak_ids",
          "swell_trend",
          "peaks"
        ],
        "properties": {
          "local_date": {
            "type": "string",
            "format": "date"
          },
          "state": {
            "enum": [
              "resolved",
              "uncertain",
              "incomplete_forecast",
              "analysis_window_completed"
            ]
          },
          "headline": {
            "type": ["string", "null"]
          },
          "headline_code": {
            "type": ["string", "null"]
          },
          "best_peak_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "swell_trend": {
            "oneOf": [
              {"$ref": "#/$defs/swellTrend"},
              {"type": "null"}
            ]
          },
          "wind_rotation": {
            "type": ["object", "null"]
          },
          "peaks": {
            "type": "array",
            "items": {"$ref": "#/$defs/peakDay"}
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["peak_id", "name", "status", "profile_version", "validation_errors"],
        "properties": {
          "peak_id": {"type": "string"},
          "name": {"type": "string"},
          "status": {
            "enum": ["incomplete", "provisional", "calibrated"]
          },
          "profile_version": {"type": "string"},
          "validation_errors": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "incidents": {
      "type": "array",
      "items": {"$ref": "#/$defs/incident"}
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "provider_url", "license", "license_url", "modified"],
      "properties": {
        "text": {"type": "string"},
        "provider_url": {"type": "string", "format": "uri"},
        "license": {"const": "CC-BY-4.0"},
        "license_url": {"type": "string", "format": "uri"},
        "modified": {"type": "boolean"}
      }
    },
    "shared_regional_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_model_cell", "notice_code", "notice_label"],
      "properties": {
        "same_model_cell": {"type": "boolean"},
        "notice_code": {"type": "string"},
        "notice_label": {"type": "string"}
      }
    }
  },
  "$defs": {
    "geoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "sizeEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_hs_m",
        "point_m",
        "minimum_m",
        "maximum_m",
        "point_k",
        "range_k_low",
        "range_k_high",
        "method",
        "calibrated"
      ],
      "properties": {
        "raw_hs_m": {"type": "number", "minimum": 0},
        "point_m": {"type": "number", "minimum": 0},
        "minimum_m": {"type": "number", "minimum": 0},
        "maximum_m": {"type": "number", "minimum": 0},
        "point_k": {"type": "number", "exclusiveMinimum": 0},
        "range_k_low": {"type": "number", "minimum": 0},
        "range_k_high": {"type": "number", "minimum": 0},
        "method": {"const": "provisional_k_times_hs"},
        "calibrated": {"const": false}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "caps", "degradations"],
      "properties": {
        "level": {"enum": ["high", "medium", "low"]},
        "caps": {
          "type": "array",
          "items": {"type": "string"}
        },
        "degradations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "swellTrend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sample_count", "variable", "method"],
      "properties": {
        "state": {
          "enum": ["building", "peaking", "dropping", "steady", "unsupported"]
        },
        "sample_count": {"type": "integer", "minimum": 0},
        "variable": {
          "enum": ["swell_height_m", "wave_height_m"]
        },
        "method": {"const": "hourly_tercile_means"}
      }
    },
    "bestWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_at", "end_at", "duration_minutes", "condition", "support"],
      "properties": {
        "start_at": {"type": "string", "format": "date-time"},
        "end_at": {"type": "string", "format": "date-time"},
        "duration_minutes": {"type": "integer", "minimum": 120},
        "condition": {
          "enum": ["small_but_surfable", "fair", "good", "very_good"]
        },
        "support": {"enum": ["hourly", "derived", "unsupported"]}
      }
    },
    "peakDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_id",
        "state",
        "condition",
        "condition_label",
        "size",
        "best_window",
        "confidence",
        "reason_codes",
        "highlighted"
      ],
      "properties": {
        "peak_id": {"type": "string"},
        "state": {
          "enum": [
            "resolved",
            "uncertain",
            "incomplete_forecast",
            "analysis_window_completed"
          ]
        },
        "condition": {
          "type": ["string", "null"],
          "enum": [
            "no_surfable_waves",
            "small_but_surfable",
            "fair",
            "good",
            "very_good",
            null
          ]
        },
        "condition_label": {"type": ["string", "null"]},
        "size": {
          "oneOf": [
            {"$ref": "#/$defs/sizeEstimate"},
            {"type": "null"}
          ]
        },
        "best_window": {
          "oneOf": [
            {"$ref": "#/$defs/bestWindow"},
            {"type": "null"}
          ]
        },
        "confidence": {"$ref": "#/$defs/confidence"},
        "reason_codes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "highlighted": {"type": "boolean"}
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident_id", "code", "severity", "occurred_at", "details"],
      "properties": {
        "incident_id": {"type": "string"},
        "code": {"type": "string"},
        "severity": {"enum": ["info", "warning", "error"]},
        "occurred_at": {"type": "string", "format": "date-time"},
        "source_id": {"type": ["string", "null"]},
        "variable": {"type": ["string", "null"]},
        "details": {"type": "object"}
      }
    }
  }
}
